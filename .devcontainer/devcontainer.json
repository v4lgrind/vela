// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/java
{
	"name": "Java",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
	"features": {
		"ghcr.io/devcontainers/features/java:1": {
			"version": "21",
			"installGradle": "true",
			"gradleVersion": "8.14.3"
		},
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/devcontainers-extra/features/vue-cli:2": {},
		"ghcr.io/stu-bell/devcontainer-features/claude-code:0": {},
		"ghcr.io/devcontainers/features/git-lfs:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code",
				"esbenp.prettier-vscode",
				"Vue.volar",
				"pranaygp.vscode-css-peek",
				"ecmel.vscode-html-css",
				"kamikillerto.vscode-colorize",
				"DavidAnson.vscode-markdownlint",
				"eamodio.gitlens",
				"christian-kohler.npm-intellisense"
			],
			"settings": {
				"java.jdt.ls.java.home": "/usr/local/sdkman/candidates/java/current"
			}
		}
	},
	"postCreateCommand": "bash .devcontainer/setup-android-sdk.sh && npm install",
	"remoteEnv": {
		"ANDROID_HOME": "/home/vscode/android-sdk",
		"ANDROID_SDK_ROOT": "/home/vscode/android-sdk",
		"PATH": "${containerEnv:PATH}:/home/vscode/android-sdk/cmdline-tools/latest/bin:/home/vscode/android-sdk/platform-tools"
	}
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "java -version",
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}