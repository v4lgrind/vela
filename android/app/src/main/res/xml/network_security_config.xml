<?xml version="1.0" encoding="utf-8"?>
<!--
  Android's <domain> element supports hostname suffix matching only — it cannot
  express IP subnets or CIDR ranges. Since Jellyfin servers are typically accessed
  via local IP addresses (192.168.x.x, 10.x.x.x, etc.) over HTTP, cleartext must
  be permitted globally. HTTPS is enforced wherever the server supports it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
