<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit" />

    <!-- Loading spinner — visible until the stream is ready to play -->
    <ProgressBar
        android:id="@+id/loading_spinner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#2f9bff"
        android:visibility="visible" />

    <!-- Controls overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000">

        <!-- Top scrim — full-bleed (NOT inset) so it always reaches every edge -->
        <View
            android:id="@+id/top_scrim"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_controls_scrim"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom scrim — full-bleed -->
        <View
            android:id="@+id/bottom_scrim"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:background="@drawable/bg_controls_scrim_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Inset container: holds the interactive controls, padded for the
             display cutout / system bars. The scrims above stay full-bleed. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/controls_inset"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <!-- Top row: back + title -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_player_button"
            android:tint="#FFFFFF"
            android:padding="10dp"
            android:contentDescription="Back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@id/btn_back"
            app:layout_constraintBottom_toBottomOf="@id/btn_back"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp" />

        <!-- Center play/pause — large, primary transport control -->
        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_pause"
            android:background="@drawable/bg_center_play"
            android:tint="#FFFFFF"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:contentDescription="Play/Pause"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Seek bar + chapter markers wrapper -->
        <FrameLayout
            android:id="@+id/seek_bar_wrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/bottom_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:contentDescription="Playback position"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb"
                android:splitTrack="false" />

            <!-- Chapter ticks are visual only; the full bar below owns touch input. -->
            <FrameLayout
                android:id="@+id/chapter_markers"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical" />
        </FrameLayout>

        <!-- Bottom row: time (left) + actions (right) -->
        <LinearLayout
            android:id="@+id/bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00:00"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" / "
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00:00"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_audio"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_audio_track"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:padding="9dp"
                android:contentDescription="Audio track"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_subtitle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_subtitles"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:padding="9dp"
                android:contentDescription="Subtitles"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_quality"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_quality"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:padding="9dp"
                android:contentDescription="Quality"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_info"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_info"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:padding="9dp"
                android:contentDescription="Stream info"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_fullscreen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_fullscreen_exit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:padding="9dp"
                android:contentDescription="Toggle fullscreen" />

        </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Seek feedback: rewind (double-tap left) -->
    <LinearLayout
        android:id="@+id/seek_feedback_back"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="40dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_seek_feedback"
        android:visibility="invisible"
        android:clickable="false">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="«"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="−10s"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Seek feedback: forward (double-tap right) -->
    <LinearLayout
        android:id="@+id/seek_feedback_fwd"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="40dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_seek_feedback"
        android:visibility="invisible"
        android:clickable="false">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="»"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+10s"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Skip Intro button — outside controls overlay so it stays visible when controls are hidden -->
    <Button
        android:id="@+id/btn_skip_intro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:text="Skip Intro"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:background="@drawable/bg_skip_button"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone" />

    <!-- Scrub time overlay — shown during long-press drag scrubbing -->
    <TextView
        android:id="@+id/tv_scrub_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="36sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="#CC000000"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone" />

    <!-- Next Episode button — mirrors Skip Intro but anchored bottom|start -->
    <Button
        android:id="@+id/btn_next_episode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="80dp"
        android:text="Next Episode"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:background="@drawable/bg_skip_button"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone" />

</FrameLayout>
