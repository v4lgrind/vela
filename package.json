{
  "name": "vela",
  "private": true,
  "version": "0.1.0",
  "description": "A cross-platform Jellyfin media client for Android, Windows, and Linux.",
  "author": "V4lgrind",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:skip-types": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "android:build": "npm run build:skip-types && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build:skip-types && npx cap sync android && cd android && ./gradlew assembleRelease",
    "desktop:runtime": "node node_modules/electron/install.js",
    "desktop:dev": "npm run desktop:runtime && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:package": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@fontsource-variable/outfit": "^5.2.8",
    "@jellyfin/sdk": "^1.0.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.15",
    "lucide-vue-next": "^0.564.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.4.1",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.6",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.1.10",
    "wait-on": "^9.0.10"
  }
}
